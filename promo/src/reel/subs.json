[
 {
  "from": 35,
  "to": 77,
  "text": "No hace falta cambiarlo todo"
 },
 {
  "from": 77,
  "to": 120,
  "text": "de un día para otro."
 },
 {
  "from": 120,
  "to": 182,
  "text": "Basta con dar el {siguiente paso}."
 },
 {
  "from": 241,
  "to": 300,
  "text": "RUMBO te ayuda a {registrar} lo que haces"
 },
 {
  "from": 300,
  "to": 351,
  "text": "y a ver cómo avanza tu proceso,"
 },
 {
  "from": 351,
  "to": 384,
  "text": "a tu manera."
 },
 {
  "from": 517,
  "to": 571,
  "text": "Anota tu evolución y consulta"
 },
 {
  "from": 571,
  "to": 621,
  "text": "tus datos de {peso, IMC y calorías}"
 },
 {
  "from": 621,
  "to": 655,
  "text": "en un mismo lugar."
 },
 {
  "from": 655,
  "to": 686,
  "text": "Cada registro cuenta"
 },
 {
  "from": 686,
  "to": 739,
  "text": "una parte de tu historia."
 },
 {
  "from": 856,
  "to": 893,
  "text": "Guarda tus {entrenamientos},"
 },
 {
  "from": 893,
  "to": 943,
  "text": "tus {rutinas} y tus {marcas}."
 },
 {
  "from": 943,
  "to": 982,
  "text": "Así puedes volver a ellos"
 },
 {
  "from": 982,
  "to": 1027,
  "text": "y reconocer todo el trabajo"
 },
 {
  "from": 1027,
  "to": 1062,
  "text": "que ya has hecho."
 },
 {
  "from": 1192,
  "to": 1246,
  "text": "Registra también tus hábitos diarios,"
 },
 {
  "from": 1246,
  "to": 1292,
  "text": "como el {agua} y los {pasos}."
 },
 {
  "from": 1292,
  "to": 1342,
  "text": "Celebra los pequeños avances"
 },
 {
  "from": 1342,
  "to": 1376,
  "text": "y construye {constancia}"
 },
 {
  "from": 1376,
  "to": 1428,
  "text": "sin exigirte perfección."
 },
 {
  "from": 1588,
  "to": 1633,
  "text": "Y adapta la experiencia a ti:"
 },
 {
  "from": 1633,
  "to": 1658,
  "text": "cambia los {colores}"
 },
 {
  "from": 1658,
  "to": 1715,
  "text": "y elige el {tema} que prefieras."
 },
 {
  "from": 1978,
  "to": 2020,
  "text": "Y tu privacidad importa:"
 },
 {
  "from": 2020,
  "to": 2054,
  "text": "tus registros se guardan"
 },
 {
  "from": 2054,
  "to": 2108,
  "text": "en {tu propio dispositivo}."
 },
 {
  "from": 2308,
  "to": 2359,
  "text": "Entrena, registra tu progreso"
 },
 {
  "from": 2359,
  "to": 2409,
  "text": "y celebra cada paso."
 },
 {
  "from": 2409,
  "to": 2431,
  "text": "RUMBO."
 },
 {
  "from": 2431,
  "to": 2486,
  "text": "Cada pequeño paso cuenta."
 },
 {
  "from": 2486,
  "to": 2521,
  "text": "{Empieza hoy}."
 }
]