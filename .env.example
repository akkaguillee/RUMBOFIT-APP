# Food scanner (Netlify Functions). Set these in Netlify → Site configuration →
# Environment variables. Never prefix them with VITE_: they must stay on the server.

# Anthropic API key for recognising foods in photos (https://console.anthropic.com).
ANTHROPIC_API_KEY=

# USDA FoodData Central API key, free at https://fdc.nal.usda.gov/api-key-signup
USDA_FDC_API_KEY=

# Optional: another Claude model for photo recognition (default: the one set in netlify/lib/vision.ts).
# RUMBO_FOOD_MODEL=

# Optional: extra origins allowed to call the functions (comma-separated), e.g. a custom domain.
# RUMBO_ALLOWED_ORIGINS=https://rumbo.example.com
